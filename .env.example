# Copy to .env.local. Use the connection string from your Neon project's Connect dialog.
DATABASE_URL=
# Donta generates a secret in .env.local. For a new deployment: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# Explicit prototype mode displays database-seeded sample drafts, with example bars.
# Set to published for the real public catalogue; sample drafts are then excluded.
CONTENT_MODE=prototype

# Optional, for networks with unreliable Node dual-stack routing:
# DATABASE_IPV4_ONLY=true
